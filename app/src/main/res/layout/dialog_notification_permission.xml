<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layoutDirection="ltr"
    android:minWidth="280dp"
    android:padding="24dp"
    app:cardCornerRadius="28dp"
    app:cardElevation="0dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="true"
        android:fontFamily="@font/open_sans_bold"
        android:gravity="center"
        android:text="notification_permission_required"
        android:textAppearance="@style/TextAppearance.Material3.ActionBar.Subtitle"
        android:textColor="@color/black" />

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/title"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/open_sans_regular"
        android:gravity="center"
        android:text="Notification permission is required in order to run app in background."
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/black" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/message"
        android:layout_marginTop="24dp"
        android:gravity="center">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeny"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_semi_bold"
            android:paddingVertical="12dp"
            android:text="deny"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/white"
            app:backgroundTint="@color/black" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAllow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="10dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:fontFamily="@font/open_sans_semi_bold"
            android:paddingVertical="12dp"
            android:text="allow"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/white" />
    </LinearLayout>
</RelativeLayout>
